# ==============================================================================
# ENVIRONMENT VARIABLES
# ==============================================================================

# Groq — used directly by the guardrails classifier (app/guardrails/rails.py, model: allam-2-7b)
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""          # second Groq key, or same as primary — Portkey's fallback target

# Portkey LLM Gateway — routes main RAG generation (app/gateway/client.py, model: openai/gpt-oss-20b)
PORTKEY_API_KEY = ""
PORTKEY_CONFIG = ""   # saved Portkey config id/slug (required if your Portkey org has block_inline_config on — create one under Configs in the dashboard, or disable that org setting)

# Qdrant Vector DB — session-scoped cache of live PubMed results (filtered by thread_id).
# Get these from your Qdrant Cloud cluster (or a local instance)
QDRANT_API_KEY = ""
QDRANT_CLUSTER_ENDPOINT = ""

# PubMed / NCBI E-utilities — see https://www.ncbi.nlm.nih.gov/books/NBK25497/ for usage guidelines.
# NCBI_CONTACT_EMAIL is required by NCBI's usage policy. NCBI_API_KEY is optional
# (raises the rate limit from 3 req/s to 10 req/s) — get one from your NCBI account settings.
NCBI_API_KEY = ""
NCBI_CONTACT_EMAIL = ""

# === Observability

# Pydantic Logfire Observability — token from your Logfire project settings
LOGFIRE_TOKEN = ""

# LangSmith — tracing for LangChain/LangGraph runs
LANGSMITH_TRACING = true
LANGSMITH_ENDPOINT = https://api.smith.langchain.com
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = ""

# Streamlit UI -> FastAPI — leave as-is for local dev; update if the backend runs elsewhere
BACKEND_URL = "http://127.0.0.1:8000"

# Eval judge LLM (keep separate from main key to avoid rate-limiting the live app)
JUDGE_GROQ = ""

#Jina AI
JINA_API_KEY = ""
